{
  "name": "resolve",
  "private": true,
  "version": "0.0.0",
  "description": "Resolve — privacy-first, voluntary browser protection and group accountability.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-brand-assets.mjs",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check": "pnpm format:check && pnpm check:headers && pnpm lint && pnpm typecheck && pnpm test",
    "check:headers": "node scripts/check-headers.mjs",
    "dev:extension": "pnpm --filter @resolve/extension dev",
    "dev:web": "pnpm --filter @resolve/web dev",
    "e2e": "pnpm --filter @resolve/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "integration": "pnpm --filter @resolve/integration integration"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "catalog:"
  }
}
